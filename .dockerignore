# ---------- 版本控制 / IDE / 工具链元数据 ----------
.git/
.github/
.fnos-test/
.gitignore
.arts/
.codeartsdoer/
.merkle-snapshot.json
.venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------- Python 缓存 / 编译产物 / 测试与类型检查产物 ----------
**/__pycache__/
__pycache__/
**/*.py[cod]
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---------- 测试与开发依赖（运行镜像不需要） ----------
tests/
conftest.py
pytest.ini
requirements-dev.txt

# ---------- 本地运行数据 / 缓存（运行时由命名卷 lit-data / lit-cache 挂载） ----------
data/
cache/
data_backup_*/
**/*.log
*.log

# ---------- 凭证 / 本地环境变量 ----------
.env*
**/.env*

# ---------- 容器与文档配置本身（构建上下文不需要；避免将来 COPY . 误带） ----------
Dockerfile
.dockerignore
docker-compose*.yml
*.md
**/*.md
