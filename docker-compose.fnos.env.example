# fnOS 部署环境变量模板：复制为 .env（与本文件同目录），按需修改后重启项目生效。
# 说明：.env 已被 gitignore，不会被提交；本模板文件可提交。

# Web 管理页端口（仅页面/接口访问用；播报走云端，不需要额外端口）
WEB_PORT=10379

# 容器运行身份：fnOS 默认用户为 1000:1000。
# 如你的 NAS 用户 UID/GID 不同，SSH 执行 `id` 查看后修改，保证能写 data/cache 目录。
PUID=1000
PGID=1000

# 可选：本地持久化目录（默认 ./data、./cache，相对项目目录）
# 建议放在 NAS 存储卷上，如 /vol1/1000/docker/lit-data
# DATA_PATH=/vol1/1000/docker/lit-data
# CACHE_PATH=/vol1/1000/docker/lit-cache

# 可选：教务引导凭证（首次部署可留空，在网页里登录；成功后以 data/ 内持久化凭证为准）
# JWXT_ACCOUNT=
# JWXT_PASSWORD=

# 可选：其他业务参数
# REMIND_BEFORE_MINUTES=30
# LOG_LEVEL=INFO
# COOKIE_REFRESH_INTERVAL=1800

# 可选：免构建编排使用的镜像（默认 latest；可固定版本，如 :v1.0.1）
# LIT_IMAGE=ghcr.io/shihao618/xiaoai_lit:latest
